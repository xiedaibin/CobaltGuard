# 阿里云容器镜像服务地址 (例如杭州区: registry.cn-hangzhou.aliyuncs.com)
ALIYUN_REGISTRY=registry.cn-hangzhou.aliyuncs.com

# 阿里云镜像命名空间名称
ALIYUN_NAMESPACE=your_namespace

# 阿里云登录用户名 (通常是你的阿里云账号登录名)
ALIYUN_USERNAME=your_username

# 阿里云登录密码 (注意是容器镜像服务的专用独立密码，而非控制台登录密码)
ALIYUN_PASSWORD=your_password

# 要构建的本地镜像名称和版本号
IMAGE_NAME=cobalt-guard
IMAGE_TAG=latest
