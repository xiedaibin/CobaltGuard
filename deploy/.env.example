# ==========================================
# CobaltGuard 生产环境环境变量配置模板
# ==========================================

# 1. 飞书机器人 Webhook (用于价格预警推送)
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
FEISHU_WEBHOOK_SECRET=xxx

# 2. 飞书应用凭证 (用于上传报表图片到飞书平台)
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# 3. 数据库路径 (容器内路径，通常无需修改)
DATABASE_URL=sqlite:///./data/cobalt.db

# 4. 时区
TZ=Asia/Shanghai
